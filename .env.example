# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# Notifications
RESEND_API_KEY=

# AI abstraction layer (see src/lib/ai) — set only the providers in use
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# WhatsApp Cloud API (invitations, notifications — not yet wired, see EDGE_FUNCTIONS.md)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Legal/company config for /terms and /privacy — see src/lib/legal/config.ts.
# OWNER INPUT REQUIRED BEFORE PUBLIC LAUNCH: none of these are secrets, but
# none are set today, so the legal pages currently show honest "to be
# published" language instead of these values. Confirm each with legal
# counsel before setting it.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_LAST_UPDATED=
